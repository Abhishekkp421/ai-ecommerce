# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=*

# Railway / Domain Settings
# Railway automatically populates RAILWAY_PUBLIC_DOMAIN or you can set CSRF_TRUSTED_ORIGINS
CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app

# Database (PostgreSQL on Railway or fallback to sqlite)
# DATABASE_URL=postgresql://username:password@host:port/database

# Email Settings (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com